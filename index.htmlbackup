  </footer>
</section>

<script src="https://cdnjs.cloudflare.com/ajax/libs/matter-js/0.19.0/matter.min.js"></script>
<script>
  /* ── CURSOR ── */
  const cursor = document.getElementById('cursor');
  document.addEventListener('mousemove', e => {
    cursor.style.left = e.clientX + 'px';
    cursor.style.top  = e.clientY + 'px';
  });
  document.querySelectorAll('a, button, .skill-card, .work-card, .media-item, .phys-block').forEach(el => {
    el.addEventListener('mouseenter', () => cursor.classList.add('hover'));
    el.addEventListener('mouseleave', () => cursor.classList.remove('hover'));
  });

  /* ── FADE IN ── */
  const fadeObs = new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.1 });
  document.querySelectorAll('.fade-in').forEach(el => fadeObs.observe(el));

  /* ── MATTER.JS PHYSICS PILLS ── */
  (function () {
    const { Engine, Runner, Bodies, Body, World, Events } = Matter;

    const stage  = document.getElementById('physics-stage');
    const canvas = document.getElementById('physics-canvas');

    /*
      Pill definitions: [domId, width, height, dropX%, spawnDelay ms, bgColor, borderColor, textColor]
      Angle is clamped each frame to ±30° so text never flips upside down.
    */
    const MAX_TILT = 0.52; /* radians ≈ 30° */

    const PILLS = [
      ['pb-email', 210, 72, 22,   0,  '#D4522A', '#D4522A',        '#F5F0E8'],  /* terracotta */
      ['pb-cs',    195, 72, 62, 200,  '#C9A84C', '#C9A84C',        '#111010'],  /* gold       */
      ['pb-cv',    165, 72, 80, 420,  'transparent', 'rgba(245,240,232,0.5)', '#F5F0E8'],  /* ghost      */
      ['pb-li',    180, 72, 40, 640,  '#2a2826', 'rgba(201,168,76,0.4)',     '#C9A84C'],  /* dark+gold  */
    ];

    let W, H, engine, runner, bodies = [], triggered = false;

    function init() {
      W = stage.offsetWidth;
      H = stage.offsetHeight;
      canvas.width  = W;
      canvas.height = H;

      engine = Engine.create({ gravity: { y: 1.6 } });

      const S = { isStatic: true, friction: 0.7, restitution: 0.1 };
      World.add(engine.world, [
        Bodies.rectangle(W / 2,  H + 30, W * 3, 60, S),
        Bodies.rectangle(-30,    H / 2,  60, H * 3, S),
        Bodies.rectangle(W + 30, H / 2,  60, H * 3, S),
      ]);

      PILLS.forEach(([id, pw, ph,,,bg, border, color]) => {
        const el = document.getElementById(id);
        el.style.width       = pw + 'px';
        el.style.height      = ph + 'px';
        el.style.opacity     = '0';
        el.style.background  = bg;
        el.style.borderColor = border;
        el.style.color       = color;
        /* Remove any class-based color overrides */
        el.classList.remove('primary', 'gold');
        el.style.transition  = 'opacity 0.25s, background 0.22s, border-color 0.22s';

        const body = Bodies.rectangle(W / 2, -ph * 2, pw - 6, ph - 6, {
          chamfer:     { radius: (ph - 6) / 2 },
          friction:    0.52,
          restitution: 0.2,
          frictionAir: 0.012,
          density:     0.004,
        });

        body._el      = el;
        body._pw      = pw;
        body._ph      = ph;
        body._spawned = false;
        bodies.push(body);
      });

      Events.on(engine, 'afterUpdate', () => {
        bodies.forEach(b => {
          if (!b._spawned) return;

          /* Clamp angle so text never goes upside-down */
          let a = b.angle % (Math.PI * 2);
          if (a >  Math.PI) a -= Math.PI * 2;
          if (a < -Math.PI) a += Math.PI * 2;

          if (Math.abs(a) > MAX_TILT) {
            const clamped = Math.sign(a) * MAX_TILT;
            Body.setAngle(b, clamped);
            Body.setAngularVelocity(b, b.angularVelocity * -0.3); /* dampen spin */
          }

          const { x, y } = b.position;
          b._el.style.transform =
            `translate(${Math.round(x - b._pw / 2)}px, ${Math.round(y - b._ph / 2)}px) rotate(${b.angle}rad)`;
        });
      });

      runner = Runner.create();
      Runner.run(runner, engine);

      setInterval(() => {
        bodies.forEach(b => {
          if (!b._spawned || b._el.classList.contains('settled')) return;
          if (Math.hypot(b.velocity.x, b.velocity.y) < 0.3 &&
              Math.abs(b.angularVelocity) < 0.01) {
            b._el.classList.add('settled');
          }
        });
      }, 300);
    }

    function spawnAll() {
      PILLS.forEach(([id, pw, ph, xPct, delay], i) => {
        setTimeout(() => {
          const b  = bodies[i];
          const sx = W * (xPct / 100) + (Math.random() - 0.5) * 50;
          const sy = -ph - Math.random() * 100;

          Body.setPosition(b, { x: sx, y: sy });
          /* Small initial tilt — stays within clamp range */
          Body.setAngle(b, (Math.random() - 0.5) * 0.4);
          Body.setVelocity(b, { x: (Math.random() - 0.5) * 3.5, y: 1 });

          World.add(engine.world, b);
          b._spawned = true;
          b._el.style.opacity = '1';
        }, delay);
      });
    }

    const obs = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting && !triggered) {
          triggered = true;
          init();
          spawnAll();
        }
      });
    }, { threshold: 0.2 });

    obs.observe(stage);
  })();
</script>

</body>
</html>
