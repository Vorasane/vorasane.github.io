      <span class="phys-label">Resume</span>
      <span class="phys-sub">Download PDF</span>
    </a>
    <a href="https://linkedin.com/in/yourhandle" target="_blank" class="phys-block" id="pb-li">
      <span class="phys-icon">💼</span>
      <span class="phys-label">LinkedIn</span>
      <span class="phys-sub">@yourhandle</span>
    </a>
  </div>

