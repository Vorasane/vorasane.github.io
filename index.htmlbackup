<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Your Name — Marketing Professional</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=DM+Sans:wght@300;400;500&family=DM+Mono:wght@400&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --ink:    #111010;
      --paper:  #F5F0E8;
      --cream:  #EDE7D9;
      --accent: #D4522A;
      --gold:   #C9A84C;
      --muted:  #7A7169;
      --serif:  'Playfair Display', Georgia, serif;
      --sans:   'DM Sans', sans-serif;
      --mono:   'DM Mono', monospace;
    }

    html { scroll-behavior: smooth; }
    body {
      background: var(--paper);
      color: var(--ink);
      font-family: var(--sans);
      font-weight: 300;
      line-height: 1.6;
      cursor: none;
      overflow-x: hidden;
    }

    /* ── CURSOR ── */
    .cursor {
      width: 10px; height: 10px;
      background: var(--accent); border-radius: 50%;
      position: fixed; top: 0; left: 0;
      pointer-events: none; z-index: 9999;
      transform: translate(-50%, -50%);
      transition: width 0.2s, height 0.2s, background 0.2s;
      mix-blend-mode: multiply;
    }
    .cursor.hover { width: 40px; height: 40px; background: var(--gold); }

    /* ── NAV ── */
    nav {
      position: fixed; top: 0; width: 100%; z-index: 100;
      display: flex; justify-content: space-between; align-items: center;
      padding: 1.2rem 3rem;
      background: var(--paper);
      border-bottom: 1px solid var(--cream);
    }
    .nav-logo { font-family: var(--serif); font-size: 1.1rem; font-style: italic; }
    .nav-links { display: flex; gap: 2rem; list-style: none; }
    .nav-links a {
      text-decoration: none; color: var(--muted);
      font-size: 0.78rem; letter-spacing: 0.12em;
      text-transform: uppercase; font-weight: 500; transition: color 0.2s;
    }
    .nav-links a:hover { color: var(--accent); }

    /* ── HERO ── */
    #hero {
      min-height: 100vh;
      display: grid; grid-template-columns: 1fr 1fr;
      padding-top: 80px; overflow: hidden;
    }
    .hero-left {
      padding: 5rem 3rem;
      display: flex; flex-direction: column; justify-content: center;
    }
    .hero-eyebrow {
      font-family: var(--mono); font-size: 0.72rem;
      letter-spacing: 0.18em; text-transform: uppercase;
      color: var(--accent); margin-bottom: 1.5rem;
    }
    .hero-name {
      font-family: var(--serif);
      font-size: clamp(3.5rem, 6vw, 6rem);
      line-height: 1.0; font-weight: 900; margin-bottom: 0.3rem;
    }
    .hero-name em { font-style: italic; color: var(--accent); }
    .hero-title {
      font-family: var(--serif);
      font-size: clamp(1.1rem, 2vw, 1.5rem);
      font-weight: 400; font-style: italic;
      color: var(--muted); margin-bottom: 2rem;
    }
    .hero-tagline {
      font-size: 1.05rem; line-height: 1.75;
      max-width: 420px; margin-bottom: 3rem; color: #333;
    }
    .hero-cta { display: inline-flex; gap: 1rem; flex-wrap: wrap; }
    .btn {
      padding: 0.85rem 2rem; font-family: var(--sans);
      font-size: 0.8rem; font-weight: 500;
      letter-spacing: 0.1em; text-transform: uppercase;
      text-decoration: none; transition: all 0.25s;
    }
    .btn-primary { background: var(--ink); color: var(--paper); border: 2px solid var(--ink); }
    .btn-primary:hover { background: var(--accent); border-color: var(--accent); }
    .btn-outline { background: transparent; color: var(--ink); border: 2px solid var(--ink); }
    .btn-outline:hover { background: var(--ink); color: var(--paper); }

    /* ── VINYL ── */
    .hero-right {
      background: var(--cream);
      position: relative;
      display: flex; align-items: center; justify-content: center;
      overflow: hidden;
    }
    .vinyl-scene {
      position: relative;
      width: 360px; height: 360px;
      display: flex; align-items: center; justify-content: center;
    }
    .vinyl-record {
      width: 360px; height: 360px; border-radius: 50%;
      background:
        repeating-radial-gradient(
          circle at 50% 50%,
          #181614 0px, #181614 2px,
          #252220 3px, #252220 6px,
          #1c1a18 7px, #1c1a18 9px
        );
      position: absolute;
      box-shadow:
        0 0 0 3px #0e0d0c,
        0 24px 70px rgba(0,0,0,0.4),
        inset 0 0 40px rgba(0,0,0,0.5);
      animation: vinyl-spin 7s linear infinite;
    }
    /* Groove sheen */
    .vinyl-record::before {
      content: '';
      position: absolute; inset: 0; border-radius: 50%;
      background: conic-gradient(
        transparent 0deg,
        rgba(255,255,255,0.04) 55deg,
        transparent 110deg,
        rgba(255,255,255,0.06) 195deg,
        transparent 270deg,
        rgba(255,255,255,0.03) 325deg,
        transparent 360deg
      );
    }
    /* Label */
    .vinyl-label {
      width: 126px; height: 126px; border-radius: 50%;
      background: var(--paper);
      position: absolute; z-index: 2;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center; gap: 2px;
      box-shadow: 0 4px 24px rgba(0,0,0,0.35);
      border: 2px solid var(--cream);
      overflow: hidden;
    }
    .vinyl-label::before {
      content: '';
      position: absolute; inset: 0; border-radius: 50%;
      background: radial-gradient(circle at 38% 33%, rgba(255,255,255,0.55) 0%, transparent 55%);
    }
    .vinyl-label-eyebrow {
      font-family: var(--mono); font-size: 0.42rem;
      letter-spacing: 0.16em; text-transform: uppercase;
      color: var(--accent); z-index: 1;
    }
    .vinyl-label-name {
      font-family: var(--serif); font-size: 0.68rem;
      font-weight: 900; text-align: center; line-height: 1.15;
      color: var(--ink); z-index: 1;
    }
    .vinyl-label-line {
      width: 46px; height: 1px; background: var(--accent);
      z-index: 1; margin: 2px 0;
    }
    .vinyl-label-stat {
      font-family: var(--serif); font-size: 1.3rem;
      font-weight: 900; color: var(--accent); z-index: 1; line-height: 1;
    }
    .vinyl-label-stat-sub {
      font-family: var(--mono); font-size: 0.4rem;
      letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--muted); z-index: 1;
    }
    .vinyl-side {
      font-family: var(--mono); font-size: 0.38rem;
      letter-spacing: 0.2em; text-transform: uppercase;
      color: var(--muted); z-index: 1; margin-top: 2px;
    }
    /* Center spindle hole */
    .vinyl-hole {
      width: 13px; height: 13px; border-radius: 50%;
      background: #d6d0c4;
      position: absolute; z-index: 3;
      box-shadow: inset 0 1px 3px rgba(0,0,0,0.3);
    }
    /* Tonearm */
    .vinyl-arm {
      position: absolute;
      top: -8px; right: -28px;
      width: 140px; height: 140px;
      transform-origin: 96% 7%;
      animation: arm-sway 7s ease-in-out infinite alternate;
      z-index: 5;
    }
    @keyframes vinyl-spin {
      from { transform: rotate(0deg); }
      to   { transform: rotate(360deg); }
    }
    @keyframes arm-sway {
      from { transform: rotate(-20deg); }
      to   { transform: rotate(-8deg); }
    }
    /* Floating skill labels */
    .vinyl-tag {
      position: absolute;
      font-family: var(--mono); font-size: 0.58rem;
      letter-spacing: 0.14em; text-transform: uppercase;
      color: var(--muted); white-space: nowrap;
    }
    .vt-1 { top: 11%; left: 3%; }
    .vt-2 { top: 11%; right: 3%; }
    .vt-3 { bottom: 13%; left: 3%; }
    .vt-4 { bottom: 13%; right: 3%; }

    /* ── SECTION COMMONS ── */
    section { padding: 6rem 3rem; }
    .section-label {
      font-family: var(--mono); font-size: 0.7rem;
      letter-spacing: 0.2em; text-transform: uppercase;
      color: var(--accent); margin-bottom: 1rem;
      display: flex; align-items: center; gap: 1rem;
    }
    .section-label::after {
      content: ''; flex: 1; max-width: 60px;
      height: 1px; background: var(--accent);
    }
    .section-heading {
      font-family: var(--serif);
      font-size: clamp(2rem, 4vw, 3.5rem);
      line-height: 1.15; font-weight: 900; margin-bottom: 1rem;
    }
    .section-heading em { color: var(--accent); font-style: italic; }

    /* ── ABOUT ── */
    #about { background: var(--ink); color: var(--paper); }
    #about .section-label { color: var(--gold); }
    #about .section-label::after { background: var(--gold); }
    #about .section-heading em { color: var(--gold); }
    .about-grid {
      display: grid; grid-template-columns: 1fr 1fr;
      gap: 5rem; align-items: start; margin-top: 3rem;
    }
    .about-text p {
      font-size: 1.05rem; line-height: 1.85;
      color: rgba(245,240,232,0.85); margin-bottom: 1.5rem;
    }
    .about-text p strong { color: var(--gold); font-weight: 500; }
    .about-facts { display: flex; flex-direction: column; gap: 1.5rem; }
    .fact-item {
      display: flex; flex-direction: column;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid rgba(255,255,255,0.08);
    }
    .fact-item:last-child { border-bottom: none; }
    .fact-label {
      font-family: var(--mono); font-size: 0.65rem;
      letter-spacing: 0.18em; text-transform: uppercase;
      color: var(--gold); margin-bottom: 0.4rem;
    }
    .fact-value { font-size: 1rem; color: var(--paper); }

    /* ── SKILLS ── */
    #skills { background: var(--paper); }
    .skills-grid {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 1.5rem; margin-top: 3rem;
    }
    .skill-card {
      background: var(--cream); padding: 2rem;
      border: 1px solid rgba(0,0,0,0.06);
      position: relative; overflow: hidden;
      transition: transform 0.25s, box-shadow 0.25s;
    }
    .skill-card::before {
      content: ''; position: absolute; top: 0; left: 0;
      width: 3px; height: 0; background: var(--accent);
      transition: height 0.3s;
    }
    .skill-card:hover { transform: translateY(-4px); box-shadow: 0 16px 40px rgba(0,0,0,0.1); }
    .skill-card:hover::before { height: 100%; }
    .skill-icon { font-size: 1.6rem; margin-bottom: 1rem; }
    .skill-name { font-family: var(--serif); font-size: 1.2rem; font-weight: 700; margin-bottom: 0.8rem; }
    .skill-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 1rem; }
    .tag {
      font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase;
      padding: 0.25rem 0.6rem; background: var(--paper);
      border: 1px solid rgba(0,0,0,0.12); color: var(--muted); font-family: var(--mono);
    }

    /* ── WORK ── */
    #work { background: var(--cream); }
    .work-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-top: 3rem; }
    .work-card {
      background: var(--paper); padding: 2.5rem;
      border: 1px solid rgba(0,0,0,0.07);
      position: relative;
      transition: transform 0.25s, box-shadow 0.25s;
      text-decoration: none; color: inherit; display: block;
    }
    .work-card:hover { transform: translateY(-5px); box-shadow: 0 20px 50px rgba(0,0,0,0.1); }
    .work-card-type {
      font-family: var(--mono); font-size: 0.65rem;
      letter-spacing: 0.15em; text-transform: uppercase;
      color: var(--accent); margin-bottom: 1rem;
    }
    .work-card-title {
      font-family: var(--serif); font-size: 1.5rem;
      font-weight: 700; line-height: 1.25; margin-bottom: 0.75rem;
    }
    .work-card-desc { font-size: 0.92rem; color: var(--muted); line-height: 1.75; margin-bottom: 1.5rem; }
    .work-metrics { display: flex; gap: 1.5rem; flex-wrap: wrap; padding-top: 1.5rem; border-top: 1px solid var(--cream); }
    .metric { display: flex; flex-direction: column; }
    .metric-num { font-family: var(--serif); font-size: 1.6rem; font-weight: 900; color: var(--accent); line-height: 1; }
    .metric-label { font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); font-family: var(--mono); }
    .work-card-arrow {
      position: absolute; top: 2.5rem; right: 2.5rem;
      font-size: 1.2rem; color: var(--cream);
      transition: color 0.2s, transform 0.2s;
    }
    .work-card:hover .work-card-arrow { color: var(--accent); transform: translate(4px, -4px); }

    /* ── MEDIA GALLERY ── */
    #media { background: var(--ink); }
    #media .section-label { color: var(--gold); }
    #media .section-label::after { background: var(--gold); }
    #media .section-heading { color: var(--paper); }
    #media .section-heading em { color: var(--gold); }

    .media-projects { display: flex; flex-direction: column; gap: 5rem; margin-top: 3rem; }

    .media-project-header {
      display: flex; align-items: flex-end; justify-content: space-between;
      margin-bottom: 1.8rem; padding-bottom: 1.2rem;
      border-bottom: 1px solid rgba(255,255,255,0.08);
    }
    .media-project-role {
      font-family: var(--mono); font-size: 0.6rem;
      letter-spacing: 0.16em; text-transform: uppercase;
      color: var(--gold); margin-bottom: 0.5rem;
      border: 1px solid rgba(201,168,76,0.25);
      display: inline-block; padding: 0.2rem 0.6rem;
    }
    .media-project-name {
      font-family: var(--serif); font-size: 2.2rem;
      font-weight: 700; color: var(--paper); line-height: 1.1;
    }
    .media-project-name span { color: var(--gold); font-style: italic; }
    .media-project-desc {
      font-size: 0.88rem; color: rgba(245,240,232,0.5);
      max-width: 340px; text-align: right; line-height: 1.7;
    }

    /* Grid */
    .media-grid { display: grid; gap: 0.7rem; }
    .media-grid-offline   { grid-template-columns: 2fr 1fr 1fr; grid-template-rows: 210px 210px; }
    .media-grid-lyrically { grid-template-columns: 1fr 1fr 2fr; grid-template-rows: 210px 210px; }
    .span-col-2 { grid-column: span 2; }
    .span-row-2 { grid-row: span 2; }

    .media-item {
      position: relative; overflow: hidden;
      background: #1a1815; cursor: pointer;
    }
    .media-item img, .media-item video {
      width: 100%; height: 100%; object-fit: cover; display: block;
      transition: transform 0.5s ease, filter 0.4s ease;
      filter: brightness(0.85) saturate(0.9);
    }
    .media-item:hover img,
    .media-item:hover video { transform: scale(1.04); filter: brightness(1) saturate(1.1); }

    .media-placeholder {
      width: 100%; height: 100%;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center; gap: 0.7rem;
      background: linear-gradient(145deg, #1e1b18 0%, #252220 100%);
      border: 1px dashed rgba(255,255,255,0.08);
      transition: border-color 0.3s;
    }
    .media-item:hover .media-placeholder { border-color: rgba(201,168,76,0.35); }
    .media-placeholder-icon { font-size: 1.8rem; opacity: 0.35; }
    .media-placeholder-text {
      font-family: var(--mono); font-size: 0.56rem;
      letter-spacing: 0.12em; text-transform: uppercase;
      color: rgba(255,255,255,0.22); text-align: center; line-height: 1.75;
    }
    .media-placeholder-text code { color: rgba(201,168,76,0.65); }

    .media-overlay {
      position: absolute; inset: 0;
      background: linear-gradient(to top, rgba(0,0,0,0.65) 0%, transparent 55%);
      opacity: 0; transition: opacity 0.35s;
      display: flex; align-items: flex-end; padding: 1rem 1.2rem;
    }
    .media-item:hover .media-overlay { opacity: 1; }
    .media-overlay-label {
      font-family: var(--mono); font-size: 0.58rem;
      letter-spacing: 0.12em; text-transform: uppercase;
      color: rgba(255,255,255,0.65);
    }
    .media-badge-video {
      position: absolute; top: 0.75rem; left: 0.75rem;
      background: var(--accent); color: white;
      font-family: var(--mono); font-size: 0.5rem;
      letter-spacing: 0.12em; text-transform: uppercase;
      padding: 0.2rem 0.55rem; z-index: 2;
    }

    .media-add-note {
      margin-top: 1.2rem; padding: 1rem 1.4rem;
      border: 1px solid rgba(255,255,255,0.05);
      background: rgba(255,255,255,0.02);
    }
    .media-add-note span {
      font-family: var(--mono); font-size: 0.6rem;
      letter-spacing: 0.08em;
      color: rgba(255,255,255,0.22); line-height: 1.8;
    }
    .media-add-note code { color: rgba(201,168,76,0.65); }

    /* ── CONTACT / PHYSICS STAGE ── */
    #contact {
      background: var(--ink); color: var(--paper);
      text-align: center; padding-bottom: 0; overflow: hidden;
    }
    #contact .section-label { justify-content: center; color: var(--gold); }
    #contact .section-label::after { display: none; }
    #contact .section-heading { color: var(--paper); }
    #contact .section-heading em { color: var(--gold); }
    .contact-sub {
      font-size: 1.05rem; color: rgba(245,240,232,0.5);
      max-width: 450px; margin: 0 auto 2rem; line-height: 1.8;
    }

    /* Physics canvas stage */
    #physics-stage {
      position: relative;
      width: 100%;
      height: 420px;
      overflow: hidden;
    }
    #physics-canvas {
      display: block;
      width: 100%;
      height: 100%;
    }

    /* HTML overlay pills — positioned by physics engine each frame */
    .phys-block {
      position: absolute;
      top: 0; left: 0;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      gap: 6px;
      text-decoration: none;
      color: var(--paper);
      border: 1px solid rgba(255,255,255,0.15);
      background: rgba(255,255,255,0.05);
      border-radius: 999px;           /* full pill */
      pointer-events: none;
      user-select: none;
      transform-origin: center center;
      transition: background 0.22s, border-color 0.22s;
    }
    .phys-block.settled { pointer-events: auto; cursor: pointer; }
    .phys-block:hover {
      background: rgba(255,255,255,0.11);
      border-color: rgba(201,168,76,0.55);
      z-index: 30;
    }
    .phys-block.primary {
      background: var(--accent);
      border-color: transparent;
    }
    .phys-block.primary:hover { background: #c74b24; }
    .phys-block.gold {
      background: transparent;
      border-color: var(--gold);
      color: var(--gold);
    }
    .phys-block.gold:hover { background: rgba(201,168,76,0.1); }

    .phys-icon  { font-size: 1.1rem; line-height: 1; }
    .phys-label {
      font-size: 0.72rem; letter-spacing: 0.14em;
      text-transform: uppercase; font-weight: 500;
      white-space: nowrap; font-family: var(--sans);
    }
    .phys-sub {
      font-size: 0.58rem; color: rgba(255,255,255,0.4);
      font-family: var(--mono); white-space: nowrap; letter-spacing: 0.06em;
    }
    .phys-block.primary .phys-sub { color: rgba(255,255,255,0.7); }
    .phys-block.gold .phys-sub { color: rgba(201,168,76,0.6); }

    footer {
      padding: 2rem 3rem;
      font-size: 0.7rem; letter-spacing: 0.08em;
      color: rgba(255,255,255,0.18); font-family: var(--mono);
      display: flex; justify-content: space-between; align-items: center;
      border-top: 1px solid rgba(255,255,255,0.05);
    }

    /* ── FADE IN ── */
    .fade-in { opacity: 0; transform: translateY(24px); transition: opacity 0.7s ease, transform 0.7s ease; }
    .fade-in.visible { opacity: 1; transform: translateY(0); }

    /* ── RESPONSIVE ── */
    @media (max-width: 900px) {
      #hero { grid-template-columns: 1fr; }
      .hero-right { height: 360px; }
      .about-grid { grid-template-columns: 1fr; gap: 3rem; }
      .work-grid { grid-template-columns: 1fr; }
      .media-grid-offline,
      .media-grid-lyrically { grid-template-columns: 1fr 1fr; grid-template-rows: auto; }
      .span-col-2 { grid-column: span 2; }
      .span-row-2 { grid-row: span 1; height: 200px; }
      .media-project-header { flex-direction: column; align-items: flex-start; gap: 0.8rem; }
      .media-project-desc { text-align: left; max-width: 100%; }
      nav { padding: 1rem 1.5rem; }
      .nav-links { gap: 1rem; }
      section { padding: 4rem 1.5rem; }
      .hero-left { padding: 4rem 1.5rem 2rem; }
      .contact-block { min-width: 130px; padding: 1.5rem 1.6rem; }
      footer { flex-direction: column; gap: 0.5rem; text-align: center; }
    }
  </style>
</head>
<body>

<div class="cursor" id="cursor"></div>

<!-- NAV -->
<nav>
  <div class="nav-logo">Your Name.</div>
  <ul class="nav-links">
    <li><a href="#about">About</a></li>
    <li><a href="#skills">Skills</a></li>
    <li><a href="#work">Work</a></li>
    <li><a href="#media">Gallery</a></li>
    <li><a href="#contact">Contact</a></li>
  </ul>
</nav>

<!-- HERO -->
<section id="hero">
  <div class="hero-left">
    <p class="hero-eyebrow">✦ Marketing Professional</p>
    <h1 class="hero-name">Your<br /><em>Name.</em></h1>
    <p class="hero-title">Social Media · Content · SEO · Email</p>
    <p class="hero-tagline">
      I turn brands into communities and scroll-stops into conversions.
      Marketing that actually sounds like a human wrote it — because one did.
    </p>
    <div class="hero-cta">
      <a href="#work" class="btn btn-primary">See My Work</a>
