<!-- CONTACT -->
<section id="contact">
  <p class="section-label">Let's Talk</p>
  <h2 class="section-heading">Good work starts with<br /><em>a conversation.</em></h2>
  <p class="contact-sub">
    Whether you need a full-stack marketing partner or just someone to make your emails
    not boring — I'd love to hear about it.
  </p>

  <div id="physics-stage">
    <canvas id="physics-canvas"></canvas>

    <!-- Pills — moved by physics engine each frame -->
    <a href="mailto:you@email.com" class="phys-block primary" id="pb-email">
      <span class="phys-icon">✉️</span>
      <span class="phys-label">Let's Collab</span>
      <span class="phys-sub">you@email.com</span>
    </a>
    <a href="#work" class="phys-block" id="pb-cs">
